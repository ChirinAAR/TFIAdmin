<UserControl x:Class="SiTech.AgroLogistica.Views.EmpleadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource BrushCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="👷 Personal" 
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" />
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="+ Registrar Nuevo Empleado" 
                    Style="{StaticResource BtnPrimary}" 
                    Command="{Binding AbrirNuevoCommand}" />
        </Grid>

        <!-- Formulario Nuevo Empleado -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardPanel}" 
                Margin="24,0,24,14" 
                Background="#F0FDF4" 
                BorderBrush="{StaticResource BrushPrimaryLight}"
                Visibility="{Binding MostrarDialogoNuevo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushPrimaryDark}" Margin="0,0,0,10" ><Run Language="es-ar" Text="Añadir Personal"/></TextBlock>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="Nombre Completo *" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="DNI" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoDni, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Puesto / Rol" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoPuesto, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="Departamento" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoDepartamento, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Teléfono Contacto" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoTelefono, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Ubicación / Base Asignada" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevaUbicacion, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,6,0">
                    <Button Content="Cancelar" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Command="{Binding CancelarNuevoCommand}" />
                    <Button Content="Guardar Empleado" Style="{StaticResource BtnPrimary}" Command="{Binding GuardarNuevoCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Contenido: Lista y Ficha -->
        <Grid Grid.Row="2" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Empleados}" SelectedItem="{Binding EmpleadoSeleccionado}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Legajo" Binding="{Binding Legajo}" Width="95" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*" />
                            <DataGridTextColumn Header="Puesto / Rol" Binding="{Binding PuestoRol}" Width="*" />
                            <DataGridTextColumn Header="Departamento" Binding="{Binding Departamento}" Width="150" />
                            <DataGridTextColumn Header="Disponibilidad" Binding="{Binding EstadoDisponibilidad}" Width="120" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding UbicacionActual}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Ficha Técnica -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding EmpleadoSeleccionado}">
                        <TextBlock Text="Legajo del Personal" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,12" />

                        <Border Background="{StaticResource BrushPrimarySubtle}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding NombreCompleto}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryDark}" />
                                <TextBlock Text="{Binding PuestoRol}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryMedium}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Legajo, StringFormat='Legajo: {0}'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="INFORMACIÓN DE ASIGNACIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,4,0,8" />

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Departamento:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Departamento}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="DNI:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Dni}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Teléfono Contacto:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Telefono}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Correo Corporativo:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Email}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Estado Actual:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding EstadoDisponibilidad}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Base de Operaciones:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding UbicacionActual}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
