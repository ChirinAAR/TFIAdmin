<UserControl x:Class="SiTech.AgroLogistica.Views.TrazabilidadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource BrushCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header del Módulo -->
        <Grid Grid.Row="0" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="🔍 Trazabilidad Integral y Cadena de Custodia" 
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" />
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="📜 Emitir Certificado de Inocuidad Digital" 
                    Style="{StaticResource BtnPrimary}" 
                    Command="{Binding GenerarCertificadoCommand}" />
        </Grid>

        <!-- Buscador y Selector de Partida -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="24,0,24,14" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Buscar Partida por Código (ej: TRZ-2026-SOJ-0914), Productor o Lote:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="Buscar Partida" 
                        Style="{StaticResource BtnSecondary}" 
                        Height="36" 
                        VerticalAlignment="Bottom" 
                        Margin="10,0,0,0" 
                        Command="{Binding BuscarCommand}" />

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding PartidaSeleccionada.ResumenGeneral}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushPrimaryMedium}" />
                    <TextBlock Text="Certificación blockchain / hash de trazabilidad activo" FontSize="11" Foreground="{StaticResource BrushTextLight}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido: Ficha de la Partida y Línea de Tiempo de Hitos -->
        <Grid Grid.Row="2" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2.2*" />
            </Grid.ColumnDefinitions>

            <!-- Resumen de la Partida -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding PartidaSeleccionada}">
                        <TextBlock Text="Datos de la Partida Granaria" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,12" />

                        <Border Background="{StaticResource BrushPrimarySubtle}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding CodigoTrazabilidad}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryDark}" />
                                <TextBlock Text="{Binding NombrePartida}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding CalidadCertificada}" FontSize="11" Foreground="{StaticResource BrushPrimaryMedium}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ORIGEN Y CONDICIONES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,4,0,8" />

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Cultivo:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Cultivo}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Productor Titular:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding ProductorCliente}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Establecimiento:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Establecimiento}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Lote Georreferenciado:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding LoteOrigen}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Volumen Consolidado:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding ToneladasTotales, StringFormat='{}{0:N1} Toneladas'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="CUSTODIA ACTUAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,10,0,8" />

                        <TextBlock Text="Silo / Almacén:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,6">
                            <TextBlock Text="{Binding SiloUbicacionActual}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Destino Final Previsto:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,12">
                            <TextBlock Text="{Binding DestinoFinalPrevisto}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushBlue}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Mensaje de Certificado -->
                        <Border Background="#EFF6FF" 
                                BorderBrush="{StaticResource BrushBlue}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="10"
                                Visibility="{Binding DataContext.MensajeCertificado, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DataContext.MensajeCertificado, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" Foreground="{StaticResource BrushBlue}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Línea de Tiempo de Hitos (Timeline) -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Línea de Tiempo del Ciclo Productivo y Logístico" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,14" />

                        <ItemsControl ItemsSource="{Binding PartidaSeleccionada.HistorialHitos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Indicador de Paso Circular -->
                                        <Border Grid.Column="0" 
                                                Background="{StaticResource BrushPrimary}" 
                                                Width="28" Height="28" 
                                                CornerRadius="14" 
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Paso}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Tarjeta del Hito -->
                                        <Border Grid.Column="1" 
                                                Background="#F8FAFC" 
                                                BorderBrush="{StaticResource BrushBorderLight}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12" 
                                                Margin="8,0,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextMain}" />
                                                    <TextBlock Text="{Binding FechaHora, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="{StaticResource BrushTextLight}" HorizontalAlignment="Right" />
                                                </Grid>

                                                <TextBlock Text="{Binding Descripcion}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,6" TextWrapping="Wrap" />

                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="👤 " FontSize="10" />
                                                        <TextBlock Text="{Binding ResponsableOEntidad}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" />
                                                        <TextBlock Text=" • 📍 " FontSize="10" Margin="6,0,0,0" />
                                                        <TextBlock Text="{Binding Ubicacion}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                                    </StackPanel>

                                                    <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding DocumentoAsociado}" FontSize="10" FontWeight="Bold" Foreground="#3730A3" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
