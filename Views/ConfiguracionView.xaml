<UserControl x:Class="SiTech.AgroLogistica.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚙️ Configuración del Sistema" 
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" />
                    <TextBlock Text="Administración de servidores, telemetría y perfiles de acceso autorizados" 
                               FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Parámetros del Sistema y Usuarios -->
                <StackPanel Grid.Column="0">

                    <!-- Parámetros Técnicos -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Parámetros de Integración y Conectividad" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,12" />

                            <TextBlock Text="Endpoint del Servidor Central API (REST):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ServidorApiEndpoint, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Frecuencia Telemetría Satelital (minutos):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding IntervaloTelemetriaMinutos, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <CheckBox Content="Sincronización en la Nube Activa" IsChecked="{Binding SincronizacionNubeActiva}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,8" />
                                </StackPanel>
                            </Grid>

                            <Button Content="🔌 Probar Conectividad con Servidor SiTech" 
                                    Style="{StaticResource BtnSecondary}" 
                                    HorizontalAlignment="Left" 
                                    Command="{Binding ProbarConexionCommand}" 
                                    Margin="0,0,0,8" />

                            <!-- Feedback de prueba -->
                            <Border Background="#ECFDF5" 
                                    BorderBrush="#10B981" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10" 
                                    Margin="0,4,0,0"
                                    Visibility="{Binding MensajePruebaConexion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding MensajePruebaConexion}" FontSize="11" FontWeight="SemiBold" Foreground="#047857" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Padrón de Usuarios del Sistema -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Usuarios y Perfiles de Acceso" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,12" />

                            <DataGrid ItemsSource="{Binding UsuariosSistema}" Height="210">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="100" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*" />
                                    <DataGridTextColumn Header="Rol / Permiso" Binding="{Binding Rol}" Width="180" />
                                    <DataGridTextColumn Header="Último Acceso" Binding="{Binding UltimoAcceso, StringFormat='{}{0:dd/MM HH:mm}'}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Columna Derecha: Equipo de Ingeniería SiTech -->
                <StackPanel Grid.Column="2"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
