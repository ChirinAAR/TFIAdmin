<UserControl x:Class="SiTech.AgroLogistica.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚙️ Configuración del Sistema y Parámetros SiTech" 
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" />
                    <TextBlock Text="Administración de cuentas de acceso, conectividad con servicios de backend e información del proyecto UTN" 
                               FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Parámetros del Sistema y Usuarios -->
                <StackPanel Grid.Column="0">

                    <!-- Parámetros Técnicos -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Parámetros de Integración Backend" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,12" />

                            <TextBlock Text="Endpoint del Servidor API (REST):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ServidorApiEndpoint, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Frecuencia Telemetría Satelital (minutos):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding IntervaloTelemetriaMinutos, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <CheckBox Content="Modo Prototipo / Simulación Activo" IsChecked="{Binding ModoSimulacionActivo}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,8" />
                                </StackPanel>
                            </Grid>

                            <Button Content="🔌 Probar Conectividad de la Capa de Servicios" 
                                    Style="{StaticResource BtnSecondary}" 
                                    HorizontalAlignment="Left" 
                                    Command="{Binding ProbarConexionCommand}" 
                                    Margin="0,0,0,8" />

                            <!-- Feedback de prueba -->
                            <Border Background="#ECFDF5" 
                                    BorderBrush="#10B981" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10" 
                                    Margin="0,4,0,0"
                                    Visibility="{Binding MensajePruebaConexion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding MensajePruebaConexion}" FontSize="11" FontWeight="SemiBold" Foreground="#047857" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Padrón de Usuarios del Sistema -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Usuarios y Perfiles de Acceso" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,12" />

                            <DataGrid ItemsSource="{Binding UsuariosSistema}" Height="210">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="100" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*" />
                                    <DataGridTextColumn Header="Rol / Permiso" Binding="{Binding Rol}" Width="180" />
                                    <DataGridTextColumn Header="Último Acceso" Binding="{Binding UltimoAcceso, StringFormat='{}{0:dd/MM HH:mm}'}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Columna Derecha: Empresa SiTech e Información UTN -->
                <StackPanel Grid.Column="2">

                    <!-- Empresa SiTech -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <Border Background="{StaticResource BrushPrimaryDark}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SiTech Software Solutions" FontSize="16" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Desarrollo de Software y Consultoría Tecnológica" FontSize="11" Foreground="#A7F3D0" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="MISIÓN EMPRESARIAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,2,0,4" />
                            <TextBlock Text="Impulsar la transformación digital del sector productivo y agroindustrial del NOA mediante soluciones de software especializadas en Agro-Logística y arquitectura escalable." 
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="VISIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,2,0,4" />
                            <TextBlock Text="Factoría de software líder del NOA con proyección internacional, destacada por conectar el software con la realidad física del entorno productivo." 
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Proyecto Integrador UTN -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Universidad Tecnológica Nacional" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" />
                            <TextBlock Text="Administración de Sistemas • TFI 2026 • 4K1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryMedium}" Margin="0,2,0,10" />

                            <TextBlock Text="EQUIPO DE DESARROLLO (INTEGRANTES):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding Integrantes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Nombre, StringFormat='★ {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMain}" />
                                            <TextBlock Text="{Binding Legajo, StringFormat='Leg. {0}'}" FontSize="11" Foreground="{StaticResource BrushTextLight}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
