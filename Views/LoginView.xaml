<UserControl x:Class="SiTech.AgroLogistica.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{StaticResource BrushCanvas}">
        <!-- Fondo Decorativo Agro -->
        <Grid.RowDefinitions>
            <RowDefinition Height="280" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushPrimaryDark}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
                <Border Background="{StaticResource BrushPrimaryLight}" 
                        CornerRadius="24" 
                        Width="48" Height="48" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,12">
                    <TextBlock Text="🌱" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SiTech AgroLogística" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center" />
                <TextBlock Text="Transformación Digital del Sector Productivo y Agroindustrial del NOA" 
                           FontSize="15" 
                           Foreground="#A7F3D0" 
                           HorizontalAlignment="Center" 
                           Margin="0,6,0,0" />
                <TextBlock Text="Universidad Tecnológica Nacional - Administración de Sistemas 4K1" 
                           FontSize="12" 
                           Foreground="#6EE7B7" 
                           HorizontalAlignment="Center" 
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Tarjeta de Login Central -->
        <Border Grid.Row="1" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Center" 
                Width="850" 
                Margin="0,-60,0,30" 
                Style="{StaticResource CardPanel}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Acceso con Credenciales -->
                <StackPanel Grid.Column="0" Margin="10">
                    <TextBlock Text="Acceso a la Plataforma" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushTextMain}" />
                    <TextBlock Text="Ingrese sus credenciales corporativas para continuar" 
                               FontSize="13" 
                               Foreground="{StaticResource BrushTextMuted}" 
                               Margin="0,4,0,20" />

                    <!-- Mensaje de Error -->
                    <Border Background="{StaticResource BrushDangerLight}" 
                            BorderBrush="{StaticResource BrushDanger}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,0,0,14"
                            Visibility="{Binding HayError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding MensajeError}" 
                                   Foreground="{StaticResource BrushDanger}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Usuario / Correo Electrónico" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" 
                             Margin="0,0,0,16" />

                    <TextBlock Text="Contraseña" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" 
                             Margin="0,0,0,24" />

                    <Button Content="Iniciar Sesión" 
                            Command="{Binding IniciarSesionCommand}" 
                            Style="{StaticResource BtnPrimary}" 
                            Height="42" 
                            FontSize="14" />

                    <TextBlock Text="* Clave de demostración predeterminada: 123" 
                               FontSize="11" 
                               Foreground="{StaticResource BrushTextLight}" 
                               Margin="0,12,0,0" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Separador Vertical -->
                <Rectangle Grid.Column="1" Fill="{StaticResource BrushBorderLight}" Width="1" Margin="10,0" />

                <!-- Columna Derecha: Perfiles Demostrativos Rápidos -->
                <StackPanel Grid.Column="2" Margin="10">
                    <TextBlock Text="Perfiles Rápidos para Demostración" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushTextMain}" />
                    <TextBlock Text="Seleccione un rol para ingresar de inmediato:" 
                               FontSize="12" 
                               Foreground="{StaticResource BrushTextMuted}" 
                               Margin="0,4,0,16" />

                    <ItemsControl ItemsSource="{Binding UsuariosDemo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" 
                                        BorderBrush="{StaticResource BrushBorderLight}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="10" 
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0" 
                                                Background="{StaticResource BrushPrimarySubtle}" 
                                                Width="34" Height="34" 
                                                CornerRadius="17">
                                            <TextBlock Text="{Binding AvatarInitials}" 
                                                       Foreground="{StaticResource BrushPrimary}" 
                                                       FontWeight="Bold" 
                                                       FontSize="12" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Datos del Rol -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NombreCompleto}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Rol}" FontSize="11" Foreground="{StaticResource BrushPrimaryMedium}" />
                                        </StackPanel>

                                        <!-- Botón Ingresar -->
                                        <Button Grid.Column="2" 
                                                Content="Ingresar" 
                                                Style="{StaticResource BtnSecondary}" 
                                                Padding="10,4" 
                                                FontSize="11" 
                                                Command="{Binding DataContext.SeleccionarPerfilDemoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
