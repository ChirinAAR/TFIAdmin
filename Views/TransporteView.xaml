<UserControl x:Class="SiTech.AgroLogistica.Views.TransporteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource BrushCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header del Módulo -->
        <Grid Grid.Row="0" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="🚚 Transporte de Cargas" 
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="⏩ Avanzar Estado de Flete" 
                        Style="{StaticResource BtnAccent}" 
                        Margin="0,0,10,0" 
                        Command="{Binding AvanzarEstadoCommand}" />
                <Button Content="+ Despachar Nuevo Flete" 
                        Style="{StaticResource BtnPrimary}" 
                        Command="{Binding AbrirNuevoDespachoCommand}" />
            </StackPanel>
        </Grid>

        <!-- Formulario Desplegable de Nuevo Despacho -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardPanel}" 
                Margin="24,0,24,14" 
                Background="{StaticResource BrushBlueLight}" 
                BorderBrush="{StaticResource BrushBlue}"
                Visibility="{Binding MostrarDialogoNuevoDespacho, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Emisión de Nuevo Despacho con Carta de Porte Digital" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushBlue}" Margin="0,0,0,10" />
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="Chofer Responsable" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoChofer, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Patente Camión / Chasis" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevaPatente, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Grano / Carga" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoGrano, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="Origen (Campo / Lote)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoOrigen, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Destino (Silo / Acopio / Puerto)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevoDestino, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Toneladas Netas (Tn)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NuevasToneladas, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,6,0">
                    <Button Content="Cancelar" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" Command="{Binding CancelarNuevoDespachoCommand}" />
                    <Button Content="Emitir Carta de Porte y Despachar" Style="{StaticResource BtnPrimary}" Command="{Binding GuardarNuevoDespachoCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Contenido: Lista y Ficha de Carta de Porte -->
        <Grid Grid.Row="2" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Panel de Tabla -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Filtrar por Estado de Viaje:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding EstadosDisponibles}" SelectedItem="{Binding FiltroEstado}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Viajes}" SelectedItem="{Binding ViajeSeleccionado}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Carta Porte (CTG)" Binding="{Binding CartaPorteNumero}" Width="135" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Patente" Binding="{Binding PatenteCamion}" Width="85" />
                            <DataGridTextColumn Header="Chofer" Binding="{Binding ChoferNombre}" Width="120" />
                            <DataGridTextColumn Header="Carga" Binding="{Binding ResumenCarga}" Width="110" />
                            <DataGridTextColumn Header="Origen" Binding="{Binding OrigenCampo}" Width="*" />
                            <DataGridTextColumn Header="Destino" Binding="{Binding DestinoAcopio}" Width="*" />
                            <DataGridTemplateColumn Header="Avance" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Value="{Binding ProgresoRuta}" VerticalAlignment="Center" Height="6" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProgresoRuta, StringFormat='{}{0:F0}%'}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="105" FontWeight="SemiBold" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Ficha Técnica de la Carta de Porte -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding ViajeSeleccionado}">
                        <TextBlock Text="Comprobante Digital de Transporte" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}" Margin="0,0,0,12" />

                        <!-- Resumen CTG -->
                        <Border Background="{StaticResource BrushBlueLight}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding CartaPorteNumero}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushBlue}" />
                                <TextBlock Text="Carta de Porte Automotor Electrónica" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                <Border Height="1" Background="#BAE6FD" Margin="0,8,0,8" />
                                <Grid>
                                    <TextBlock Text="Estado Operativo:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding Estado}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DATOS DEL VEHÍCULO Y CONDUCTOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,4,0,8" />

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Chofer Titular:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding ChoferNombre}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="DNI Conductor:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding ChoferDni}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Patente Camión / Semi:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding ResumenVehiculo}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Empresa Fletera:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding EmpresaTransporte}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="TRAYECTO Y PESAJE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,10,0,8" />

                        <TextBlock Text="Punto de Carga:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,6">
                            <TextBlock Text="{Binding OrigenCampo}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Punto de Descarga / Acopio:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,8">
                            <TextBlock Text="{Binding DestinoAcopio}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimaryMedium}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Peso Neto de Grano:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding PesoNetoTn, StringFormat='{}{0:N1} Toneladas'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="OBSERVACIONES TÉCNICAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextLight}" Margin="0,10,0,6" />
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <TextBlock Text="{Binding Observaciones}" FontSize="11" Foreground="{StaticResource BrushTextMain}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
