<Window x:Class="SiTech.AgroLogistica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SiTech.AgroLogistica.ViewModels"
        mc:Ignorable="d"
        Title="SiTech AgroLogística - Plataforma de Gestión Agroindustrial" 
        Height="840" Width="1340"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}">

    <Grid>
        <!-- CASO 1: No Autenticado (Muestra directamente LoginView) -->
        <ContentControl Content="{Binding CurrentViewModel}"
                        Visibility="{Binding EstaAutenticado, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <!-- CASO 2: Autenticado (Muestra Header de Navegación Superior y Body Dinámico) -->
        <Grid Visibility="{Binding EstaAutenticado, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- HEADER SUPERIOR DE NAVEGACIÓN -->
            <Border Grid.Row="0" Background="{StaticResource BrushPrimaryDark}" Padding="16,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Fila Superior: Marca, Versión y Perfil del Usuario -->
                    <Grid Grid.Row="0" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Logotipo SiTech -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource BrushPrimaryLight}" 
                                    CornerRadius="16" 
                                    Width="32" Height="32" 
                                    Margin="0,0,10,0">
                                <TextBlock Text="🌱" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SiTech" FontSize="18" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text=" AgroLogística" FontSize="18" FontWeight="Light" Foreground="#86EFAC" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Perfil y Cierre de Sesión -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Avatar y Datos -->
                            <Border Background="#1E3A24" CornerRadius="20" Padding="10,4" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource BrushPrimaryLight}" Width="26" Height="26" CornerRadius="13" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding UsuarioActual.AvatarInitials}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding UsuarioActual.NombreCompleto}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UsuarioActual.Rol}" Foreground="#86EFAC" FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Botón Salir -->
                            <Button Content="Cerrar Sesión" 
                                    Style="{StaticResource BtnDanger}" 
                                    Padding="10,5" 
                                    FontSize="11"
                                    Command="{Binding CerrarSesionCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Fila Inferior: Menú de Pestañas de Navegación -->
                    <Border Grid.Row="1" Background="#11331B" CornerRadius="8" Padding="4,2">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">

                                <!-- 1. Dashboard -->
                                <Button Content="🏠 Dashboard" Command="{Binding NavegarCommand}" CommandParameter="Dashboard">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Dashboard">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 2. Cultivos -->
                                <Button Content="🌱 Cultivos" Command="{Binding NavegarCommand}" CommandParameter="Cultivos">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Cultivos">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 3. Cosecha -->
                                <Button Content="🚜 Cosecha" Command="{Binding NavegarCommand}" CommandParameter="Cosecha">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Cosecha">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 4. Transporte -->
                                <Button Content="🚚 Transporte" Command="{Binding NavegarCommand}" CommandParameter="Transporte">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Transporte">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 5. Acopio & Stock -->
                                <Button Content="🏭 Acopio &amp; Stock" Command="{Binding NavegarCommand}" CommandParameter="Acopio">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Acopio">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 6. Clima & Alertas -->
                                <Button Command="{Binding NavegarCommand}" CommandParameter="Clima">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Clima">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌤️ Clima &amp; Alertas" VerticalAlignment="Center" />
                                        <Border Background="#DC2626" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CantidadAlertasActivas}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <!-- 7. Trazabilidad -->
                                <Button Content="🔍 Trazabilidad" Command="{Binding NavegarCommand}" CommandParameter="Trazabilidad">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Trazabilidad">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Separador sutil -->
                                <Rectangle Fill="#1E4D2B" Width="1" Margin="8,4" />

                                <!-- 8. Clientes -->
                                <Button Content="👥 Clientes" Command="{Binding NavegarCommand}" CommandParameter="Clientes">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Clientes">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 9. Campañas / Proyectos -->
                                <Button Content="🌾 Proyectos" Command="{Binding NavegarCommand}" CommandParameter="Campanas">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Campanas">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 10. Empleados -->
                                <Button Content="👷 Personal" Command="{Binding NavegarCommand}" CommandParameter="Empleados">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Empleados">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 11. Reportes -->
                                <Button Content="📊 Reportes" Command="{Binding NavegarCommand}" CommandParameter="Reportes">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Reportes">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 12. Configuración -->
                                <Button Content="⚙️ Configuración" Command="{Binding NavegarCommand}" CommandParameter="Configuracion">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnNavTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="Configuracion">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- CUERPO PRINCIPAL DINÁMICO (BODY) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
