<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta SiTech AgroLogística NOA -->
    <Color x:Key="ColorPrimaryDark">#0D2818</Color>
    <Color x:Key="ColorPrimary">#1B5E20</Color>
    <Color x:Key="ColorPrimaryMedium">#2E7D32</Color>
    <Color x:Key="ColorPrimaryLight">#4CAF50</Color>
    <Color x:Key="ColorPrimarySubtle">#E8F5E9</Color>

    <Color x:Key="ColorAccent">#D97706</Color>
    <Color x:Key="ColorAccentLight">#FEF3C7</Color>
    <Color x:Key="ColorBlue">#0284C7</Color>
    <Color x:Key="ColorBlueLight">#E0F2FE</Color>
    <Color x:Key="ColorDanger">#DC2626</Color>
    <Color x:Key="ColorDangerLight">#FEE2E2</Color>

    <Color x:Key="ColorCanvas">#F1F5F9</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#CBD5E1</Color>
    <Color x:Key="ColorBorderLight">#E2E8F0</Color>

    <Color x:Key="ColorTextMain">#0F172A</Color>
    <Color x:Key="ColorTextMuted">#475569</Color>
    <Color x:Key="ColorTextLight">#94A3B8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="{StaticResource ColorPrimaryDark}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryMedium" Color="{StaticResource ColorPrimaryMedium}" />
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}" />
    <SolidColorBrush x:Key="BrushPrimarySubtle" Color="{StaticResource ColorPrimarySubtle}" />

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentLight" Color="{StaticResource ColorAccentLight}" />
    <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource ColorBlue}" />
    <SolidColorBrush x:Key="BrushBlueLight" Color="{StaticResource ColorBlueLight}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerLight" Color="{StaticResource ColorDangerLight}" />

    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource ColorBorderLight}" />

    <SolidColorBrush x:Key="BrushTextMain" Color="{StaticResource ColorTextMain}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextLight" Color="{StaticResource ColorTextLight}" />

</ResourceDictionary>
